# Database
DB_NAME=careerpilot
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# OAuth2 Clients
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Security
JWT_SECRET=Q2FyZWVyUGlsb3RBdXRoU2VjcmV0S2V5Rm9yRGV2RW52aXJvbm1lbnQxMjM0NTY3ODkwMTIzNDU2Nzg5MA==
JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Mail (SMTP)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password

# App
FRONTEND_URL=http://localhost:5173
SPRING_PROFILES_ACTIVE=dev

# AI (Ollama)
# Для нативной установки: скачайте с https://ollama.com/download и установите
# После установки Ollama автоматически запустится на http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Encryption (для шифрования чувствительных данных в БД)
# Должен быть ровно 16, 24 или 32 символа для AES
ENCRYPTION_MASTER_KEY=your-super-secret-master-key-32

# Telegram Bot (для уведомлений)
TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_telegram_bot_username